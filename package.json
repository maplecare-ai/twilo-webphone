{
  "name": "twilio-webphone",
  "version": "1.0.0",
  "private": true,
  "description": "Browser softphone (Twilio): make call, receive call, receive SMS.",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "npm --prefix web run dev",
    "start": "node server/index.js",
    "build": "npm --prefix web install && npm --prefix web run build",
    "setup": "npm install && npm --prefix web install"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "twilio": "^5.3.5"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
