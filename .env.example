# ── Server ──
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# ── App login (single user gate for the phone UI) ──
APP_LOGIN_EMAIL=you@example.com
APP_LOGIN_PASSWORD=change-me

# ── Twilio ──
# Account SID (starts AC...) — Console home.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# API Key SID (starts SK...) + its Secret — Console → Account → API keys & tokens → Create API key.
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret
# Auth token — used to validate incoming webhook signatures. Console home.
TWILIO_AUTH_TOKEN=your_auth_token
# TwiML App SID (starts AP...) — Console → Voice → TwiML → TwiML Apps → create one,
# set its Voice URL to  PUBLIC_URL/voice/outgoing  and paste its SID here.
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your Twilio phone number in E.164. Seeds the first line on a brand-new install; after that
# the lines are managed in the app (sidebar → Manage lines) and this is only the fallback
# caller ID for a request that names no line.
TWILIO_NUMBER=+18005550100
# Optional, bootstrap only: seed several lines at once on a fresh store, "number|Label"
# comma-separated. Ignored once the store has any line in it, so it can't fight the UI.
# TWILIO_NUMBERS=+18005550100|Main line,+18005550101|Support,+18005550102|Billing
# Client identity the browser registers as (any label; inbound calls dial <Client>THIS</Client>).
TWILIO_IDENTITY=webphone
# How the REST client authenticates: "apikey" (default) or "token" to use TWILIO_AUTH_TOKEN
# instead. Use "token" only if the API key secret is lost — voice still needs a valid API
# key, since access tokens can only be signed with one.
TWILIO_REST_AUTH=apikey

# ── Line storage ──
# Where the list of lines lives. Unset → server/lines-store.json next to the code, which is
# all local dev needs. Set it in any deployed environment: a container filesystem does not
# survive a redeploy, and the lines are the one piece of state this app owns.
#   docker compose up -d   →   postgres://webphone:webphone@localhost:5432/webphone
# DATABASE_URL=
# Managed Postgres (RDS etc.) serves a cert Node won't chain to a public root. Set this to
# keep the transport encrypted while skipping that check.
# PGSSL=no-verify

# ── Call recording ──
# Records both directions from the moment the far end answers (dual channel).
# Set to false to disable. Check the consent rules for the places you call.
RECORD_CALLS=true

# ── Webhook signature validation ──
# Leave false for the very first local run; set true once PUBLIC_URL is stable.
VALIDATE_TWILIO=false
# Public HTTPS base that Twilio can reach (your ngrok URL), no trailing slash.
# e.g. https://abcd-1234.ngrok-free.app
PUBLIC_URL=
